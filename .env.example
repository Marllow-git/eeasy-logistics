# eeasy-logistics local environment: one file for the service stack (PLAT-2) and the apps (PLAT-4).
#
#   cp .env.example .env      # .env is gitignored; never commit it
#
# Read by: compose.yaml (every profile), tools/native-stack.sh and tools/stack.sh (`set -a; . ./.env`),
# the CI workflows (pr.yml), and the API through packages/config. As copied, it starts the API
# against the Compose `dev` profile or the native stack (same ports on 127.0.0.1) with no edits:
#
#   APP_ENV=local pnpm --filter api dev      # the dev script sets APP_ENV=local itself
#
# The API reads this file only when the process environment itself says APP_ENV=local; the file's
# own APP_ENV is ignored and the process environment wins over the file. ci, staging and production
# take variables from the environment or the host's secret store only (platform §3).
#
# Every value here is a local placeholder for a laptop or a CI runner: not a secret, and never to be
# used for staging or production. Production refuses to start the api and worker without the
# variables marked [production], and the migrate job without DATABASE_URL_OWNER; it refuses plain
# redis:// and http:// where marked. Each role holds only its own database URL in staging and
# production (ADR-0031): the api and worker are refused the owner, maintenance and admin URLs.
# An empty value counts as unset.
# The isolated stacks (tools/stack.sh, profiles stack-a and stack-b) use the dev ports +100 and +200.

# === Service stack (compose.yaml, tools/; not read by the API) ===================================

# PostgreSQL superuser of the Compose containers and the native dedicated cluster (user "postgres").
POSTGRES_PASSWORD=local-postgres-password

# Password of elx_owner, created by tools/postgres/init/01-roles.sql (data §4.4).
ELX_OWNER_PASSWORD=local-owner-password
# Password of elx_app.
ELX_APP_PASSWORD=local-app-password
# Password of elx_platform.
ELX_PLATFORM_PASSWORD=local-platform-password
# Password of elx_maintenance.
ELX_MAINTENANCE_PASSWORD=local-maintenance-password

# MinIO (Silo) root user; also the API's storage access key id below.
MINIO_ROOT_USER=elx-local
# MinIO root password (at least 8 characters); also the API's storage secret below.
MINIO_ROOT_PASSWORD=local-minio-password
# The versioned bucket minio-init creates; also STORAGE_BUCKET below.
MINIO_BUCKET=elx-local

# OSRM host for VROOM. Unset in wave 0: OSRM arrives with INT-5 (PLAT-2 decision 2.5).
OSRM_HOST=
# OSRM port for VROOM. Unset in wave 0.
OSRM_PORT=

# Not configured through variables yet: Mailpit SMTP 127.0.0.1:1025 (UI 8025) and the WhatsApp stub
# on 127.0.0.1:8080. The orders that add the mail adapter and the messaging stub adapter (PLAT-9)
# add their URL variables to packages/config and here.

# === API (packages/config) =======================================================================

# --- app ---------------------------------------------------------------------------------------
# Environment name: local, ci, staging or production. Required everywhere. Set it in the process
# environment: the API ignores this line in a .env file (listed here for completeness).
APP_ENV=local
# HTTP port the API listens on. Default 3000.
PORT=3000
# Public origin of the web app (links in messages, CORS and Origin checks). [production]
# No URL variable that is not a secret may carry a password (user:password@).
PUBLIC_WEB_URL=http://localhost:3001
# Public origin of the platform console, apps/admin on its own hostname (ADR-0038); local port
# 3002 (`pnpm --filter admin dev`). [production]
PUBLIC_ADMIN_URL=http://localhost:3002
# Public origin of the API.
PUBLIC_API_URL=http://localhost:3000

# --- db: one URL per database role (data §4.4), passwords as above -----------------------------
# elx_owner: the migration job (--role migrate) and partition jobs only; required for migrate in
# production, refused for api and worker in staging and production.
DATABASE_URL_OWNER=postgres://elx_owner:local-owner-password@127.0.0.1:5432/elx
# elx_app: API and worker pools for tenant work. [production]
DATABASE_URL_APP=postgres://elx_app:local-app-password@127.0.0.1:5432/elx
# elx_platform: cross-tenant platform handlers and system jobs. [production]
DATABASE_URL_PLATFORM=postgres://elx_platform:local-platform-password@127.0.0.1:5432/elx
# elx_maintenance: the per-account export and deletion tool only (wave 1); required by no role
# yet, refused for api and worker in staging and production.
DATABASE_URL_MAINTENANCE=postgres://elx_maintenance:local-maintenance-password@127.0.0.1:5432/elx
# Pool size for the elx_app pool, 1 to 200. Default 10.
DATABASE_POOL_SIZE_APP=10
# Pool size for the elx_platform pool, 1 to 200. Default 5.
DATABASE_POOL_SIZE_PLATFORM=5
# Superuser for local and ci tooling only: the integration tests' scratch databases and the
# elx_seed template (pnpm --filter api seed --template). Staging and production refuse it for
# every role. The
# native stack in database mode uses your own superuser: postgres://<you>@127.0.0.1:5432/postgres.
DATABASE_URL_ADMIN=postgres://postgres:local-postgres-password@127.0.0.1:5432/postgres
# Row-level security, on or off (default off). With on, the migration job enables RLS on every
# table that has a tenant_isolation policy (the api-test-rls CI lane); off leaves it disabled
# until the wave 1 exit migration (data §4.5). Read at migration time only.
ELX_RLS=off

# --- redis -------------------------------------------------------------------------------------
# Queues, rate limits, short caches; redis:// or rediss://. [production]
# Production requires rediss:// (TLS); plain redis:// is for the local stacks only.
REDIS_URL=redis://127.0.0.1:6379

# --- storage (S3-compatible: MinIO/Silo locally) -----------------------------------------------
# The four below go together (all set or all empty). [production]
# S3 API endpoint; https:// in production, plain http:// for the local stacks only.
STORAGE_ENDPOINT=http://127.0.0.1:9000
# Bucket for proofs, labels and exports (MINIO_BUCKET locally).
STORAGE_BUCKET=elx-local
# Access key id, limited to the one bucket in production (MINIO_ROOT_USER locally).
STORAGE_ACCESS_KEY_ID=elx-local
# Secret access key (MINIO_ROOT_PASSWORD locally). Secret.
STORAGE_SECRET_ACCESS_KEY=local-minio-password
# Optional public read domain for objects served without signing (empty: signed URLs only).
STORAGE_PUBLIC_URL=

# --- auth --------------------------------------------------------------------------------------
# Id of the token signing key; goes with AUTH_SIGNING_KEY. [production]
AUTH_SIGNING_KEY_ID=
# Token signing key: at least 32 characters, at least 16 of them distinct
# (openssl rand -base64 48). Secret. [production]
AUTH_SIGNING_KEY=
# Access token lifetime in seconds. Default 900 (15 minutes).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Staff refresh token lifetime in seconds. Default 2592000 (30 days).
AUTH_STAFF_REFRESH_TTL_SECONDS=2592000
# Driver refresh token lifetime in seconds. Default 7776000 (90 days).
AUTH_DRIVER_REFRESH_TTL_SECONDS=7776000

# --- messaging (WhatsApp) ----------------------------------------------------------------------
# Provider: stub, meta or bsp. Unset means stub in local and ci. Production refuses stub and needs
# meta or bsp unless MESSAGING_DISABLED=true.
MESSAGING_PROVIDER=stub
# true pauses all messaging (maintenance windows); true or false. Default false.
MESSAGING_DISABLED=false
# Provider access token; required for meta and bsp. Secret.
MESSAGING_ACCESS_TOKEN=
# Provider sender id (phone number id); required for meta and bsp.
MESSAGING_SENDER_ID=

# --- push --------------------------------------------------------------------------------------
# Expo access token for the push service. Secret.
EXPO_ACCESS_TOKEN=

# --- geo ---------------------------------------------------------------------------------------
# Hudhud API key (geocoding, distance matrix). Secret.
HUDHUD_API_KEY=
# VROOM route optimiser URL (Compose dev profile; the native stack has no VROOM).
VROOM_URL=http://127.0.0.1:3030
# OSRM URL, the distance-matrix fallback from wave 2 (optional).
OSRM_URL=

# --- observability -----------------------------------------------------------------------------
# OpenTelemetry OTLP endpoint for traces and metrics; https:// in production.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sentry DSN for the api and worker.
SENTRY_DSN=
# PostHog project API key.
POSTHOG_API_KEY=

# --- credentials (per-account secrets at rest, data §10) ---------------------------------------
# Every key that must still decrypt: comma-separated <key id>:<base64 of 32 bytes>.
# Generate a key with: openssl rand -base64 32. Secret. [production]
CREDENTIALS_KEYS=
# The key id new encryptions use; must be in CREDENTIALS_KEYS. [production]
CREDENTIALS_ACTIVE_KEY_ID=

# === Web app: public, inlined into the browser bundle at build time ==============================
# Next.js reads its own .env files from apps/web: put these in apps/web/.env.local. Never a secret.
# Environment name shown to the client: local, ci, staging or production. Required.
NEXT_PUBLIC_APP_ENV=local
# Sentry DSN for the web app.
NEXT_PUBLIC_SENTRY_DSN=
# PostHog project API key for the web app.
NEXT_PUBLIC_POSTHOG_KEY=

# === Driver app: public, inlined into the app bundle at build time ===============================
# Expo reads its own .env files from apps/driver: put these in apps/driver/.env. Never a secret.
# Environment name: local, ci, staging or production. Required.
EXPO_PUBLIC_APP_ENV=local
# API base URL the app calls; https in production. Required.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Sentry DSN for the driver app.
EXPO_PUBLIC_SENTRY_DSN=
# PostHog project API key for the driver app.
EXPO_PUBLIC_POSTHOG_KEY=

# === Contract tests (pnpm --filter contracts test:contract) ======================================
# Origin of the running API the contract tests call; the runner's --api flag wins. Read from the
# process environment only, never from this file.
CONTRACT_API_URL=http://localhost:3000
