# Local-only settings for the service stack: compose.yaml (every profile) and
# tools/native-stack.sh read the same file (PLAT-2).
#
#   cp .env.example .env      # .env is gitignored; never commit it
#
# The values below are placeholders for a laptop or a CI runner. They are not
# secrets, and none of them may be used for staging or production
# (platform §3: real secrets live in the host's secret store).

# PostgreSQL superuser of the Compose containers (user "postgres").
POSTGRES_PASSWORD=local-postgres-password

# The four application roles created by tools/postgres/init/01-roles.sql (data §4.4).
ELX_OWNER_PASSWORD=local-owner-password
ELX_APP_PASSWORD=local-app-password
ELX_PLATFORM_PASSWORD=local-platform-password
ELX_MAINTENANCE_PASSWORD=local-maintenance-password

# MinIO root credentials (password: at least 8 characters) and the versioned bucket.
MINIO_ROOT_USER=elx-local
MINIO_ROOT_PASSWORD=local-minio-password
MINIO_BUCKET=elx-local

# OSRM endpoint for VROOM. Unset in wave 0: OSRM arrives with INT-5 (plan decision 2.5).
OSRM_HOST=
OSRM_PORT=
