{
  "name": "@eeasy-logistics/driver",
  "version": "0.0.0",
  "private": true,
  "description": "Expo driver app with Expo Router (ADR-0021, driver app §9).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest && pnpm run test:architecture",
    "test:architecture": "depcruise app test --config .dependency-cruiser.cjs"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false
  },
  "dependencies": {
    "@eeasy-logistics/config": "workspace:*",
    "@eeasy-logistics/i18n": "workspace:*",
    "expo": "58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@eeasy-logistics/config-eslint": "workspace:*",
    "@eeasy-logistics/config-ts": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "jest-expo": "~58.0.13",
    "typescript": "6.0.3"
  }
}
