{
  "name": "@eeasy-logistics/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js App Router platform console: platform and auth route groups on the admin hostname (ADR-0038; web §1).",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "check:budget": "node ../web/scripts/check-budget.ts .",
    "start": "next start -p 3001",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm run test:architecture && pnpm run test:unit",
    "test:architecture": "depcruise src tests next.config.ts --config .dependency-cruiser.cjs",
    "test:census": "playwright test --config tests/census.config.ts",
    "test:unit": "node --test --test-reporter=dot \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@eeasy-logistics/config": "workspace:*",
    "@eeasy-logistics/contracts": "workspace:*",
    "@eeasy-logistics/i18n": "workspace:*",
    "@eeasy-logistics/ui": "workspace:*",
    "@sentry/nextjs": "10.78.0",
    "@tanstack/react-query": "5.105.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "posthog-js": "1.442.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eeasy-logistics/config-eslint": "workspace:*",
    "@eeasy-logistics/config-ts": "workspace:*",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3"
  }
}
