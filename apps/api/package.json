{
  "name": "@eeasy-logistics/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS API: kernel, delivery and wms contexts (ADR-0003, ADR-0026).",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "APP_ENV=local PORT=4000 nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "migrate": "pnpm run build && node dist/main.js --role migrate",
    "seed": "pnpm run build && node dist/seed/main.js",
    "seed:census": "pnpm run build && node dist/seed/census-main.js",
    "test": "vitest run && pnpm run test:architecture",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:architecture": "depcruise src test/architecture/fixture --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@eeasy-logistics/config": "workspace:*",
    "@eeasy-logistics/contracts": "workspace:*",
    "@eeasy-logistics/db": "workspace:*",
    "@eeasy-logistics/i18n": "workspace:*",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/instrumentation": "0.223.0",
    "@opentelemetry/instrumentation-express": "0.71.1",
    "@opentelemetry/instrumentation-http": "0.223.0",
    "@opentelemetry/instrumentation-ioredis": "0.71.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "@sentry/node": "10.78.0",
    "bullmq": "6.5.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "libphonenumber-js": "1.13.15",
    "nodemailer": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eeasy-logistics/config-eslint": "workspace:*",
    "@eeasy-logistics/config-ts": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/cli": "0.8.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "postgres": "3.4.9",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
