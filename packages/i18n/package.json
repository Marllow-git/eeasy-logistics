{
  "name": "@eeasy-logistics/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Arabic and English catalogues (<locale>/<namespace>.json) and the typed t() helper.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && pnpm run test:architecture",
    "test:architecture": "depcruise src test --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "@eeasy-logistics/config-eslint": "workspace:*",
    "@eeasy-logistics/config-ts": "workspace:*",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
