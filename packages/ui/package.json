{
  "name": "@eeasy-logistics/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system (ADR-0033): tokens, Tailwind styles, Radix-based components, the shell both web apps render (WEB-1) and the self-hosted IBM Plex Sans Arabic subset.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./cn": "./src/cn.ts",
    "./status": "./src/status.ts",
    "./intl": "./src/intl.ts",
    "./components/*": "./src/components/*/*.tsx",
    "./shell": "./src/shell/index.ts",
    "./shell/request-config": "./src/shell/request-config.ts",
    "./shell/locale-switch": "./src/shell/locale-switch.tsx",
    "./shell/global-error-document": "./src/shell/global-error-document.tsx",
    "./observability": "./src/observability/index.ts",
    "./session/proxy": "./src/session/proxy.ts",
    "./session/tokens": "./src/session/tokens.ts",
    "./session/headers": "./src/session/headers.ts",
    "./session/csp-sink": "./src/session/csp-sink.ts",
    "./auth/*": "./src/auth/*.tsx",
    "./session": "./src/session/session-provider.tsx",
    "./session/user-menu": "./src/session/user-menu.tsx",
    "./query": "./src/query/query-provider.tsx",
    "./authz": "./src/authz/can.tsx",
    "./form": "./src/form/form.tsx",
    "./form/fields": "./src/form/fields.tsx",
    "./table": "./src/table/data-table.tsx",
    "./table/list-params": "./src/table/list-params.ts",
    "./table/cursor-list": "./src/table/cursor-list.ts",
    "./table/filters": "./src/table/filters.tsx",
    "./settings/reason-codes": "./src/settings/reason-codes.tsx",
    "./settings/status-chips": "./src/settings/status-chips.tsx",
    "./settings/site-form": "./src/settings/site-form.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && pnpm run test:architecture",
    "test:architecture": "depcruise src test --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@eeasy-logistics/contracts": "workspace:*",
    "@eeasy-logistics/i18n": "workspace:*",
    "@hookform/resolvers": "6.0.2",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.24",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "next-intl": "4.14.9",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react-hook-form": "7.91.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eeasy-logistics/config-eslint": "workspace:*",
    "@eeasy-logistics/config-ts": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
