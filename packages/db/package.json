{
  "name": "@eeasy-logistics/db",
  "version": "0.0.0",
  "private": true,
  "description": "Shared database helpers: pools per role, unit of work, repository bases (data architecture §1.2, §4; PLAT-5).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./platform": "./src/platform.ts",
    "./migrate": "./src/migrate.ts",
