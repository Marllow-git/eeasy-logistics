  },
  "devDependencies": {
    "@eeasy-logistics/config-eslint": "workspace:*",
    "@eeasy-logistics/config-ts": "workspace:*",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@eeasy-logistics/config": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  }
}
