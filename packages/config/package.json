{
  "name": "@eeasy-logistics/config",
  "version": "0.0.0",
  "private": true,
  "description": "Validated runtime configuration: the only code that reads environment variables (PLAT-4).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./web": "./src/web.ts",
