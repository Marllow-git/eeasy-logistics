  "devDependencies": {
    "@eeasy-logistics/config-eslint": "workspace:*",
    "@eeasy-logistics/config-ts": "workspace:*",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
